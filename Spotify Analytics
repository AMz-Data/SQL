# For this project, I used Spotify data from Kaggle.
# Next I created a table to insert Spotify data.
# Finally, I performed analytics on the data using SQL. 

# First I created the table: 
CREATE TABLE BIT_DB.Spotifydata (
id integer PRIMARY KEY,
artist_name varchar NOT NULL,
track_name varchar NOT NULL,
track_id varchar NOT NULL,
popularity integer NOT NULL,
danceability decimal(4,3) NOT NULL,
energy decimal(4,3) NOT NULL,
key integer NOT NULL,
loudness decimal(5,3) NOT NULL,
mode integer NOT NULL,
speechiness decimal(5,4) NOT NULL,
acousticness decimal(6,5) NOT NULL,
instrumentalness text NOT NULL,
liveness decimal(5,4) NOT NULL,
valence decimal(4,3) NOT NULL,
tempo decimal(6,3) NOT NULL,
duration_ms integer NOT NULL,
time_signature integer NOT NULL 
)

#Next I inserted the Spotify Data .csv into the table.

#Finally, I investigated the data using the following SQL queries. 

-- 1. List the track that have a 90 or higher popluarity score. 

SELECT track_name,
popularity
FROM BIT_DB.Spotifydata
WHERE popularity > 89 
ORDER BY popularity DESC;


-- 2. List the top 10 danceability tracks and their time signature.

SELECT track_name,
danceability, 
time_signature
FROM BIT_DB.Spotifydata
ORDER BY danceability DESC
LIMIT 10;

-- 3. (a)What artist has the most tracks in the dataset and (b)list the track names.

--a.

SELECT artist_name
,COUNT(artist_name)
FROM BIT_DB.Spotifydata
GROUP BY artist_name
ORDER BY COUNT(artist_name)DESC;

--b.

SELECT artist_name
,track_name
FROM BIT_DB.Spotifydata
WHERE artist_name like '%Olivia Rodrigo%';

-- 4. What songs have a time signature that is not 4? List the track name, aritst name, time signature, popularity, and danceability. 

SELECT track_name
,artist_name
,time_signature
,popularity
,danceability
FROM BIT_DB.Spotifydata
WHERE time_signature <>4;

-- 5.What are the 3 least popular songs?

SELECT track_name
,artist_name
,popularity
FROM BIT_DB.Spotifydata
ORDER BY popularity ASC
LIMIT 3;
